# Copy to .env for local runs (`npm run dev` loads it automatically).

# "dev" = locally minted tokens (no Azure needed). "entra" = real Entra ID tokens.
AUTH_MODE=dev
PORT=3000

# Required for AUTH_MODE=entra
# ENTRA_TENANT_ID=<directory-tenant-id>      # or "organizations" for multi-tenant
# ENTRA_CLIENT_ID=<api-app-registration-client-id>
# ENTRA_APP_ID_URI=api://<client-id>         # default; set if you use a custom App ID URI
# ENTRA_REQUIRED_SCOPE=access_as_user
# ENTRA_ALLOWED_TENANTS=<tid1>,<tid2>        # multi-tenant allow-list

# Public origin. On App Service this defaults to https://$WEBSITE_HOSTNAME.
# PUBLIC_BASE_URL=https://localhost:3000
# Overrides the `resource` in /.well-known/oauth-protected-resource (default: <base>/mcp)
# MCP_RESOURCE_ID=
